<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.kubetrain</groupId>
	<artifactId>kube-train-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>kube-train-api</name>
	<description>API REST principale — réservation de trains, déployée sur GKE</description>
	<properties>
		<java.version>21</java.version>
		<!-- Override Tomcat version pour CVE-2026-41293/43512/43515 (Spring Boot 4.0.6 = 11.0.21, fix = 11.0.22) -->
		<tomcat.version>11.0.22</tomcat.version>
		<!-- SonarCloud : clés à aligner avec l'organisation GitHub -->
		<sonar.organization>samiyc</sonar.organization>
		<sonar.projectKey>samiyc_kube-train</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<!--
		  Exclusions du coverage : classes infra/config qui ne contiennent pas de logique métier.
		  Pratique standard Spring Boot — ces classes sont testées implicitement par les @SpringBootTest.
		  Conformes aux recommandations SonarCloud pour les projets Java/Spring.
		-->
		<sonar.coverage.exclusions>
			**/config/**,
			**/entity/**,
			**/dto/**,
			**/outbox/**,
			**/*Application.java
		</sonar.coverage.exclusions>
	</properties>
	<!-- Spring Cloud BOM + Google Cloud BOM : gèrent les versions transitives -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2025.1.1</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Google Cloud BOM : gère les versions gRPC/Protobuf/Guava des libs GCP -->
			<dependency>
				<groupId>com.google.cloud</groupId>
				<artifactId>libraries-bom</artifactId>
				<version>26.50.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Validation (@Valid, @NotBlank, @Size...) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Swagger UI + OpenAPI 3 (compatible Spring Boot 4) -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.8</version>
		</dependency>
		<!-- Lombok : réduit le boilerplate (@Builder, @Getter, @Slf4j...) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- Spring Kafka (starter = spring-kafka + autoconfiguration Spring Boot 4) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka</artifactId>
		</dependency>
		<!-- Spring Data JPA (Hibernate) : ORM + repositories -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
			Micrometer + Prometheus (J4 — Les 3 piliers de l'observabilité)
			🎯 Micrometer = facade de métriques (comme SLF4J pour les logs)
			   → API vendor-neutral : Counter, Gauge, Timer, DistributionSummary
			   → micrometer-registry-prometheus = exporter spécifique Prometheus
			   → Expose /actuator/prometheus en format texte Prometheus
			   → En prod : Prometheus scrape ce endpoint, Grafana visualise
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- OAuth2 Resource Server : validation JWT (Keycloak local, ou Google OIDC sur GKE) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- Google Cloud Pub/Sub : remplace Kafka sur GKE (profil gcp) -->
		<dependency>
			<groupId>com.google.cloud</groupId>
			<artifactId>google-cloud-pubsub</artifactId>
		</dependency>

		<!-- Driver PostgreSQL (runtime : utilisé uniquement lors de l'exécution, pas à la compilation) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Flyway support PostgreSQL : migrations SQL versionnées (V1__, V2__...) -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Spring Security Test : @WithMockUser, SecurityMockMvcConfigurers -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Spring Cloud Contract : génère des tests à partir des contrats YAML -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-contract-verifier</artifactId>
			<scope>test</scope>
		</dependency>

    <!-- JUnit Platform Suite : @Suite, @IncludeEngines, @SelectPackages pour RunCucumberTest -->
    <dependency>
    	<groupId>org.junit.platform</groupId>
    	<artifactId>junit-platform-suite</artifactId>
    	<scope>test</scope>
    </dependency>
    <!-- Tests Cucumber -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>7.22.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-spring</artifactId>
      <version>7.22.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>7.22.0</version>
      <scope>test</scope>
    </dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- JaCoCo : génère target/site/jacoco/jacoco.xml lu par SonarCloud -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
				Spring Cloud Contract Maven Plugin
				🎯 Ce plugin fait 2 choses :
				  1. Génère des tests JUnit à partir des contrats YAML (vérifie le PRODUCER)
				  2. Génère des stubs WireMock (JAR) pour les CONSUMERS
				Les tests générés étendent BaseContractTest et vérifient que
				notre API respecte les contrats définis dans src/test/resources/contracts/
			-->
			<plugin>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-contract-maven-plugin</artifactId>
        <version>5.0.2</version>
				<extensions>true</extensions>
				<configuration>
					<baseClassForTests>com.kubetrain.api.BaseContractTest</baseClassForTests>
					<testMode>MOCKMVC</testMode>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
